<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. Prestigious Project Hero Card (Dark Oxford Navy Gradient) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@android:color/transparent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_card"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_accent_chip">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_academic_cap"
                            app:tint="@color/accent_dark"
                            android:contentDescription="Academic Subject" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EXAM PREPARATION"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:textColor="@color/accent_light" />

                        <TextView
                            android:id="@+id/text_project_title_large"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Chips Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:id="@+id/badge_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="English"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_primary_container"
                        android:background="@drawable/bg_language_chip"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp" />

                    <TextView
                        android:id="@+id/badge_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Standard Detail"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_dark"
                        android:background="@drawable/bg_accent_chip"
                        android:layout_marginStart="10dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_project_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="#E2E8F0"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Generated Study Guide Card (Shown when PDF exists) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_latest_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            style="@style/Widget.ExamPrep.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_language_chip">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_document_guide"
                            app:tint="@color/badge_guide_text"
                            android:contentDescription="PDF Guide" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Study Guide PDF Ready"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface" />

                        <TextView
                            android:id="@+id/text_guide_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Generated study guide"
                            android:textSize="12sp"
                            android:textColor="@color/on_surface_light"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_open_guide"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Open PDF"
                        style="@style/Widget.ExamPrep.Button.Primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_share_guide"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Share"
                        style="@style/Widget.ExamPrep.Button.Outlined" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Generated Exam Practice Card (Shown when Exam PDF / Quiz exists) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_latest_exam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            style="@style/Widget.ExamPrep.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_language_chip">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_quiz_exam"
                            app:tint="@color/badge_exam_text"
                            android:contentDescription="Exam Practice" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_exam_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Exam Practice Test Ready"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface" />

                        <TextView
                            android:id="@+id/text_exam_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Practice Questions Ready"
                            android:textSize="12sp"
                            android:textColor="@color/on_surface_light"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Action row 1: Interactive Practice Mode -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_start_practice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="🎯 Launch Interactive Practice Mode"
                    style="@style/Widget.ExamPrep.Button.Accent" />

                <!-- Action row 2: PDF view & share -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_open_exam_pdf"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="View PDF Paper"
                        style="@style/Widget.ExamPrep.Button.Outlined" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_share_exam_pdf"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Share PDF"
                        style="@style/Widget.ExamPrep.Button.Outlined" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. Generated Presentation Card (Shown when PPTX exists) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_latest_slides"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            style="@style/Widget.ExamPrep.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_accent_chip">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_presentation_deck"
                            app:tint="@color/badge_slides_text"
                            android:contentDescription="Presentation Slides" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_slides_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Presentation Deck Ready"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface" />

                        <TextView
                            android:id="@+id/text_slides_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PowerPoint (.pptx) • Widescreen 16:9"
                            android:textSize="12sp"
                            android:textColor="@color/on_surface_light"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_open_slides"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Open PPTX"
                        style="@style/Widget.ExamPrep.Button.Primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_share_slides"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Share"
                        style="@style/Widget.ExamPrep.Button.Outlined" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. Generated Narrated Video Card (Shown when MP4 exists) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_latest_video"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            style="@style/Widget.ExamPrep.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_language_chip">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_video_presentation"
                            app:tint="@color/badge_video_text"
                            android:contentDescription="Narrated Video" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_video_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Narrated Video Ready"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface" />

                        <TextView
                            android:id="@+id/text_video_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="720p HD Video • Synchronized TTS Narration"
                            android:textSize="12sp"
                            android:textColor="@color/on_surface_light"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_play_video"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="▶ Play Video"
                        style="@style/Widget.ExamPrep.Button.Primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_share_video"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Share Video"
                        style="@style/Widget.ExamPrep.Button.Outlined" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 6. Study Materials Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            style="@style/Widget.ExamPrep.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_folder_materials"
                        app:tint="@color/primary"
                        android:contentDescription="Materials" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Study Materials"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_files"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Add Files"
                        android:textStyle="bold"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:textColor="@color/primary"
                        app:backgroundTint="@color/primary_container" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_empty_files"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_files"
                    android:textAlignment="center"
                    android:lineSpacingExtra="3dp"
                    android:padding="28dp"
                    android:textColor="@color/on_surface_medium"
                    android:textSize="13sp"
                    android:visibility="visible" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_files"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 7. Generation Studio Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp"
            style="@style/Widget.ExamPrep.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AI Generation Studio"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Generate structured study materials grounded strictly in your files"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface_light"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="14dp" />

                <!-- 1. Generate Guide PDF (Hero Action) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_generate_guide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📄 Generate Study Guide PDF"
                    android:enabled="false"
                    style="@style/Widget.ExamPrep.Button.Primary" />

                <!-- 2. Generate Slides -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_generate_slides"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 Generate Presentation (.pptx)"
                    android:enabled="false"
                    style="@style/Widget.ExamPrep.Button.Outlined"
                    android:layout_marginTop="10dp" />

                <!-- 3. Generate Exam Questions -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_generate_questions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📝 Generate Exam Practice Questions"
                    android:enabled="false"
                    style="@style/Widget.ExamPrep.Button.Outlined"
                    android:layout_marginTop="10dp" />

                <!-- 4. Generate Narrated Video -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_generate_video"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎬 Generate Narrated Video Lecture"
                    android:enabled="false"
                    style="@style/Widget.ExamPrep.Button.Outlined"
                    android:layout_marginTop="10dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp" />

                <!-- 5. Test AI Pipeline -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_ai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚡ Test AI Pipeline &amp; Cost Tracker"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:textColor="@color/primary"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
