<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_practice"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:title="Exam Practice Mode"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <ProgressBar
        android:id="@+id/progress_quiz"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:progress="10"
        android:progressTint="@color/accent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Question Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.ExamPrep.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/text_q_counter"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Question 1 of 10"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary" />

                        <TextView
                            android:id="@+id/text_q_difficulty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Medium"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_dark"
                            android:background="@drawable/bg_accent_chip"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_q_topic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Topic: Photosynthesis"
                        android:textSize="12sp"
                        android:textColor="@color/on_surface_light"
                        android:layout_marginTop="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/text_q_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="What is the primary role of chlorophyll during photosynthesis?"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/on_surface"
                        android:textStyle="bold" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MCQ Options Container -->
            <LinearLayout
                android:id="@+id/layout_mcq_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp" />

            <!-- Freeform Answer Container (For Short Answer / Essay) -->
            <LinearLayout
                android:id="@+id/layout_freeform"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="12dp">

                <EditText
                    android:id="@+id/edit_practice_answer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="4"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:hint="Write your answer here"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/on_surface_medium"
                    android:importantForAutofill="no" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_check_answer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Check My Answer"
                    style="@style/Widget.ExamPrep.Button.Primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AI feedback uses your configured API key and may use credits. You can reveal the model answer for free."
                    android:textSize="12sp"
                    android:textColor="@color/on_surface_medium"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reveal_answer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reveal Model Answer &amp; Rubric"
                    style="@style/Widget.ExamPrep.Button.Outlined" />
            </LinearLayout>

            <!-- Explanation & Feedback Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                style="@style/Widget.ExamPrep.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/text_feedback_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✓ Correct! (Answer: B)"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/success" />

                    <TextView
                        android:id="@+id/text_feedback_explanation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Explanation goes here..."
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/on_surface_medium"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/surface"
        android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_prev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Previous"
            android:enabled="false"
            style="@style/Widget.ExamPrep.Button.Outlined" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_next"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Next"
            style="@style/Widget.ExamPrep.Button.Primary" />

    </LinearLayout>

</LinearLayout>
