<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/dialog_gen_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AI Generation"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />

    <ProgressBar
        android:id="@+id/dialog_gen_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/dialog_gen_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Initializing..."
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurface"
        android:alpha="0.8"
        android:layout_marginTop="8dp" />

    <!-- Results Section (Visible after completion) -->
    <LinearLayout
        android:id="@+id/layout_gen_results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/dialog_gen_cost_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cost: $0.00000"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/success"
            android:background="@drawable/bg_language_chip"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/dialog_gen_tokens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tokens: 0 in / 0 out"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.7"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generated JSON Output:"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="12dp" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@color/surface_variant"
            android:padding="8dp"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/dialog_gen_json"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/on_surface"
                android:textIsSelectable="true" />
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</LinearLayout>
