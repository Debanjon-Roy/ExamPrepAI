<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <action
        android:id="@+id/action_global_project"
        app:destination="@id/projectFragment"
        app:popUpTo="@id/homeFragment"
        app:popUpToInclusive="false" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.examprep.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_project"
            app:destination="@id/projectFragment" />
    </fragment>

    <fragment
        android:id="@+id/projectFragment"
        android:name="com.example.examprep.ui.project.ProjectFragment"
        android:label="@string/title_project"
        tools:layout="@layout/fragment_project">
        <argument
            android:name="projectId"
            app:argType="long" />
    </fragment>

</navigation>
